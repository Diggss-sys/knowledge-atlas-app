/*
 * base.uss — the shared foundation styles for the Knowledge Atlas operator UI (UNITY_UI.md:
 * "you own the shared base styles in UI/Shared/"). E3's participant screens consume these too, so
 * changes here are reviewed by both owners. A calm dark theme consistent with the IMGUI studio:
 * one type scale, one spacing scale, panel/heading/label/status primitives — no per-control colours.
 */

/* ---- design tokens (spacing + type scale + palette) ---- */
:root {
    --ka-space-1: 4px;
    --ka-space-2: 8px;
    --ka-space-3: 12px;
    --ka-space-4: 16px;
    --ka-space-5: 24px;

    --ka-font-sm: 11px;
    --ka-font-md: 13px;
    --ka-font-lg: 16px;
    --ka-font-xl: 20px;

    --ka-bg:        rgb(28, 30, 34);
    --ka-panel:     rgb(38, 41, 46);
    --ka-border:    rgb(58, 62, 68);
    --ka-text:      rgb(222, 226, 230);
    --ka-text-dim:  rgb(150, 156, 162);
    --ka-accent:    rgb(120, 170, 255);
    --ka-ok:        rgb(96, 200, 128);
    --ka-error:     rgb(226, 96, 96);
}

/* ---- structural primitives ---- */
.ka-root {
    flex-grow: 1;
    background-color: var(--ka-bg);
    color: var(--ka-text);
    font-size: var(--ka-font-md);
    padding: var(--ka-space-4);
}

.ka-panel {
    background-color: var(--ka-panel);
    border-color: var(--ka-border);
    border-width: 1px;
    border-radius: 6px;
    padding: var(--ka-space-4);
    margin-bottom: var(--ka-space-4);
}

.ka-heading {
    font-size: var(--ka-font-xl);
    -unity-font-style: bold;
    color: var(--ka-text);
    margin-bottom: var(--ka-space-3);
}

.ka-subheading {
    font-size: var(--ka-font-lg);
    -unity-font-style: bold;
    color: var(--ka-text);
    margin-bottom: var(--ka-space-2);
}

.ka-label {
    font-size: var(--ka-font-md);
    color: var(--ka-text);
}

.ka-label--dim {
    color: var(--ka-text-dim);
    font-size: var(--ka-font-sm);
}

/* ---- status / validation states ---- */
.ka-status {
    font-size: var(--ka-font-md);
    color: var(--ka-text-dim);
    margin-top: var(--ka-space-2);
}

.ka-status--ok {
    color: var(--ka-ok);
}

.ka-status--error {
    color: var(--ka-error);
}

.ka-diff-list {
    min-height: 40px;
    margin-top: var(--ka-space-2);
}

.ka-diff-row {
    font-size: var(--ka-font-sm);
    margin-bottom: var(--ka-space-1);
}

.ka-button {
    height: 32px;
    margin-top: var(--ka-space-3);
}

.ka-button:disabled {
    opacity: 0.4;
}
