/*
 * base.uss — the shared foundation styles for the Knowledge Atlas operator UI (UNITY_UI.md:
 * "you own the shared base styles in UI/Shared/"). E3's participant screens consume these too, so
 * changes here are reviewed by both owners.
 *
 * Palette = the lab's OFFICIAL design system, taken verbatim from
 * https://xrlab.ucsd.edu/ka/160sp/_track_pages_shared.css (:root tokens): light cream surfaces,
 * navy/teal structure, amber for warnings, rose for errors/blocked, and a reserved purple set for
 * AI affordances (the U5 copilot). Reference typography is Georgia headings / Arial body — Unity
 * needs font assets for those, so headings use weight+navy for now (font assets = visual polish).
 */

/* ---- design tokens (spacing + type scale + lab palette) ---- */
:root {
    --ka-space-1: 4px;
    --ka-space-2: 8px;
    --ka-space-3: 12px;
    --ka-space-4: 16px;
    --ka-space-5: 24px;

    --ka-font-sm: 11px;
    --ka-font-md: 13px;
    --ka-font-lg: 16px;
    --ka-font-xl: 20px;

    /* lab tokens (names mirror _track_pages_shared.css) */
    --ka-navy:      #1C3D3A;
    --ka-teal:      #2A7868;
    --ka-teal-lt:   #5AC8AA;
    --ka-teal-bg:   #E6F5F0;
    --ka-amber:     #E8872A;
    --ka-amber-lt:  #FFF3E0;
    --ka-amber-dk:  #9A5010;
    --ka-cream:     #F7F4EF;
    --ka-ink:       #2C2C2C;
    --ka-muted:     #6B6B6B;
    --ka-line:      #D8D0C5;
    --ka-white:     #FFFFFF;
    --ka-rose:      #A84F6B;
    --ka-rose-lt:   #F8EBF0;
    --ka-gold:      #F5A623;
    /* reserved for the AI copilot's affordances (U5) — do not use elsewhere */
    --ka-ai-bg:     #F0EBF8;
    --ka-ai-border: #C8B4E8;
    --ka-ai-fg:     #3D2E6B;
    --ka-ai-label:  #6B4FA8;

    /* semantic aliases the components consume */
    --ka-bg:        var(--ka-cream);
    --ka-panel:     var(--ka-white);
    --ka-border:    var(--ka-line);
    --ka-text:      var(--ka-ink);
    --ka-text-dim:  var(--ka-muted);
    --ka-accent:    var(--ka-teal);
    --ka-ok:        var(--ka-teal);
    --ka-error:     var(--ka-rose);
}

/* ---- structural primitives ---- */
.ka-root {
    flex-grow: 1;
    background-color: var(--ka-bg);
    color: var(--ka-text);
    font-size: var(--ka-font-md);
    padding: var(--ka-space-4);
}

.ka-panel {
    background-color: var(--ka-panel);
    border-color: var(--ka-border);
    border-width: 1px;
    border-radius: 6px;
    padding: var(--ka-space-4);
    margin-bottom: var(--ka-space-4);
}

/* Navy band for app chrome (matches the site's fixed nav; gold for the wordmark). */
.ka-topbar {
    background-color: var(--ka-navy);
    padding: var(--ka-space-3) var(--ka-space-4);
    margin-bottom: var(--ka-space-4);
}

.ka-topbar {
    flex-direction: row;
    align-items: center;
}

.ka-wordmark {
    color: var(--ka-gold);
    font-size: var(--ka-font-lg);
    -unity-font-style: bold;
    margin-right: var(--ka-space-3);
}

.ka-wordmark-sub {
    color: var(--ka-teal-lt);
    font-size: var(--ka-font-sm);
    letter-spacing: 2px;
    -unity-text-align: middle-left;
}

/* ---- two-column body ---- */
.ka-body {
    flex-direction: row;
    flex-grow: 1;
}

/* left rail: fixed-width control column */
.ka-rail {
    width: 384px;
    flex-shrink: 0;
    margin-right: var(--ka-space-4);
}

/* right: the live preview fills the remaining space */
.ka-preview-col {
    flex-grow: 1;
}

.ka-preview-row {
    flex-direction: row;
    flex-grow: 1;
}

.ka-preview-pane {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: var(--ka-space-3);
}

.ka-preview-caption {
    font-size: var(--ka-font-md);
    -unity-font-style: bold;
    color: var(--ka-navy);
    margin-bottom: var(--ka-space-1);
}

.ka-preview {
    flex-grow: 1;
    min-height: 360px;
    background-color: rgb(14, 15, 17);
    border-width: 1px;
    border-color: var(--ka-border);
    border-radius: 6px;
    -unity-background-scale-mode: scale-and-crop;
}

/* the pair card carries the science; a teal left edge sets it apart from the plain control cards */
.ka-panel--accent {
    border-left-width: 3px;
    border-left-color: var(--ka-teal);
}

/* small caps section marker (e.g. VALIDATION) */
.ka-eyebrow {
    color: var(--ka-teal);
    font-size: var(--ka-font-sm);
    letter-spacing: 1px;
    -unity-font-style: bold;
    margin-top: var(--ka-space-3);
    margin-bottom: var(--ka-space-1);
}

/* ---- sliders: give each row breathing room and a readable label/value ---- */
.ka-slider {
    margin-top: var(--ka-space-3);
    margin-bottom: var(--ka-space-2);
}

.ka-slider .unity-base-field__label {
    color: var(--ka-text);
    font-size: var(--ka-font-md);
    min-width: 110px;
}

.ka-slider .unity-base-slider__tracker {
    background-color: var(--ka-line);
}

.ka-slider .unity-base-slider__dragger {
    background-color: var(--ka-teal);
    border-color: var(--ka-navy);
}

.ka-slider .unity-text-element {
    color: var(--ka-text);
}

.ka-dropdown {
    margin-top: var(--ka-space-3);
    margin-bottom: var(--ka-space-2);
}

.ka-dropdown .unity-base-field__label {
    color: var(--ka-text);
    min-width: 140px;
}

.ka-heading {
    font-size: var(--ka-font-xl);
    -unity-font-style: bold;
    color: var(--ka-navy);
    margin-bottom: var(--ka-space-3);
}

.ka-subheading {
    font-size: var(--ka-font-lg);
    -unity-font-style: bold;
    color: var(--ka-teal);
    margin-bottom: var(--ka-space-2);
}

.ka-label {
    font-size: var(--ka-font-md);
    color: var(--ka-text);
}

.ka-label--dim {
    color: var(--ka-text-dim);
    font-size: var(--ka-font-sm);
}

/* ---- status / validation states (site semantics: teal=valid, rose=blocked, amber=warn) ---- */
.ka-status {
    font-size: var(--ka-font-md);
    color: var(--ka-text-dim);
    margin-top: var(--ka-space-2);
}

.ka-status--ok {
    color: var(--ka-ok);
    background-color: var(--ka-teal-bg);
}

.ka-status--error {
    color: var(--ka-error);
    background-color: var(--ka-rose-lt);
}

.ka-status--warn {
    color: var(--ka-amber-dk);
    background-color: var(--ka-amber-lt);
}

.ka-diff-list {
    min-height: 40px;
    margin-top: var(--ka-space-2);
    border-color: var(--ka-border);
    border-width: 1px;
    border-radius: 4px;
    padding: var(--ka-space-2);
}

.ka-diff-row {
    font-size: var(--ka-font-sm);
    margin-bottom: var(--ka-space-1);
}

.ka-button {
    height: 32px;
    margin-top: var(--ka-space-3);
    background-color: var(--ka-teal);
    color: var(--ka-white);
    border-width: 0;
    border-radius: 4px;
}

.ka-button:hover {
    background-color: var(--ka-navy);
}

.ka-button:disabled {
    opacity: 0.4;
}

/* the publish CTA: amber, the site's call-to-action colour, so it draws the eye when unlocked */
.ka-button--primary {
    background-color: var(--ka-amber);
    height: 38px;
    -unity-font-style: bold;
}

.ka-button--primary:hover {
    background-color: var(--ka-amber-dk);
}

/* AI copilot affordances (U5) — the site reserves a distinct purple so AI-driven edits are always
   visually attributed, never disguised as the operator's own input. */
.ka-ai-panel {
    background-color: var(--ka-ai-bg);
    border-color: var(--ka-ai-border);
    border-width: 1px;
    border-radius: 6px;
    padding: var(--ka-space-3);
}

.ka-ai-label {
    color: var(--ka-ai-label);
    font-size: var(--ka-font-sm);
    -unity-font-style: bold;
}
